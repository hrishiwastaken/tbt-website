generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  THERAPIST
  RECEPTIONIST
}

enum TherapistStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  therapist    Therapist?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Therapist {
  id              String              @id @default(uuid())
  userId          String?             @unique
  user            User?               @relation(fields: [userId], references: [id])
  name            String
  slug            String              @unique
  bio             String
  photo           String?
  feeMinor        Int
  commissionBps   Int?
  status          TherapistStatus     @default(PENDING)
  isActive        Boolean             @default(false)
  services        Service[]
  availability    TherapistAvailability[]
  slotBlocks      SlotBlock[]
  bookings        Booking[]
  bookingSlots    BookingSlot[]
  ledgerEntries   LedgerEntry[]
  payouts         Payout[]
  commissionSettings CommissionSetting[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Service {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  description     String
  durationMinutes Int
  priceMinor      Int
  tagline         String?
  image           String?
  suitableFor     String[]
  availability    String[]
  process         String?
  isActive        Boolean     @default(true)
  therapists      Therapist[]
  bookings        Booking[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model TherapistAvailability {
  id          String    @id @default(uuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id])
  dayOfWeek   Int
  startTime   String
  endTime     String

  @@unique([therapistId, dayOfWeek, startTime])
}

model SlotBlock {
  id          String    @id @default(uuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id])
  startAt     DateTime
  endAt       DateTime
  reason      String?
  createdAt   DateTime  @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  clientName  String
  quote       String
  status      String   @default("PENDING")
  rating      Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  phone            String
  age              Int?
  dob              String? // YYYY-MM-DD — deprecated, retained only for records created before the age migration; run prisma/backfill-client-age.js to populate age from it
  emergencyContact String
  gdprConsent      Boolean   @default(false)
  bookings         Booking[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdAt])
}

model Booking {
  id              String    @id @default(uuid())
  therapistId     String
  therapist       Therapist @relation(fields: [therapistId], references: [id])
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id])
  dateTime        DateTime
  durationMinutes Int
  amountMinor     Int
  discountMinor   Int       @default(0)
  taxMinor        Int       @default(0)
  currency        String    @default("INR")
  commissionBps   Int       @default(0)
  counselingType  String?
  status          String    @default("PENDING")
  paymentStatus   String    @default("UNPAID")
  invoiceNumber   String?   @unique
  cancellationReason String?
  expiresAt       DateTime?
  notes           String?
  slot            BookingSlot?
  statusHistory   BookingStatusHistory[]
  payments        PaymentRecord[]
  ledgerEntries   LedgerEntry[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dateTime])
  @@index([status])
}

model BookingSlot {
  id          String    @id @default(uuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id])
  startAt     DateTime
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])

  @@unique([therapistId, startAt])
}

model BookingStatusHistory {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  fromStatus String?
  toStatus   String
  actorType  String
  actorId    String?
  reason     String?
  createdAt  DateTime @default(now())
}

model PaymentRecord {
  id                String   @id @default(uuid())
  bookingId         String
  booking           Booking  @relation(fields: [bookingId], references: [id])
  provider          String
  kind              String
  amountMinor       Int
  status            String
  providerOrderId   String?
  providerPaymentId String?
  providerRef       String?
  failureReason     String?
  metadata          String?
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LedgerEntry {
  id            String    @id @default(uuid())
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  paymentRecordId String?
  entryType     String
  amountMinor   Int
  therapistId   String?
  therapist     Therapist? @relation(fields: [therapistId], references: [id])
  payoutId      String?
  payout        Payout?   @relation(fields: [payoutId], references: [id])
  description   String
  createdAt     DateTime  @default(now())
}

model Payout {
  id            String    @id @default(uuid())
  therapistId   String
  therapist     Therapist @relation(fields: [therapistId], references: [id])
  amountMinor   Int
  status        String
  method        String
  reference     String?
  note          String?
  initiatedById String?
  paidAt        DateTime?
  ledgerEntries LedgerEntry[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CommissionSetting {
  id            String    @id @default(uuid())
  scope         String
  therapistId   String?
  therapist     Therapist? @relation(fields: [therapistId], references: [id])
  commissionBps Int
  effectiveFrom DateTime
  createdById   String?
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  externalId String
  status     String
  error      String?
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}

model InternshipApplication {
  id                  String   @id @default(uuid())
  fullName            String
  email               String
  phone               String
  college             String
  course              String
  yearOrSemester      String
  internshipType      String
  preferredStart      DateTime
  statementOfPurpose  String
  resumeFileName      String
  resumeMimeType      String
  resumeData          Bytes
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
